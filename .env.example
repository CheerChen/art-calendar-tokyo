# Copy to .env for local runs. In CI these come from GitHub repo
# Variables (non-secret) and Secrets (keys). Empty/unset falls back to the
# defaults baked into extract.py — so you only set what you want to change.

# --- Production backend (used by scraper.py) ---
# Swap the model here, no code change. DASHSCOPE_API_KEY alone still works
# because LLM_API_KEY falls back to it, and glm-5.1 is hosted on DashScope too.
LLM_MODEL=glm-5.1
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=                      # falls back to DASHSCOPE_API_KEY if unset
DASHSCOPE_API_KEY=your-dashscope-key

# Optional tuning (defaults shown):
# LLM_MAX_TOKENS=16384
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=300                   # seconds; prevents silent multi-minute hangs

# NOTE: thinking/reasoning mode is auto-disabled by endpoint (DashScope ->
# enable_thinking, bigmodel/z.ai -> thinking.type). A brand-new endpoint not in
# extract._thinking_off_body() may need adding there, or calls can hang.

# --- A/B eval candidate (used by eval_models.py only, not production) ---
# EVAL_MODEL=glm-5.1                # required to run eval_models.py
# EVAL_BASE_URL=                    # defaults to the reference's endpoint
# EVAL_API_KEY=                     # defaults to the reference's key
